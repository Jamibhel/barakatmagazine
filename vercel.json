{
  "version": 2,
  "public": true,
  "cleanUrls": true,
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "styles.css",
      "use": "@vercel/static"
    },
    {
      "src": "app.js",
      "use": "@vercel/static"
    },
    {
      "src": "data.js",
      "use": "@vercel/static"
    },
    {
      "src": "supabase.js",
      "use": "@vercel/static"
    },
    {
      "src": "anime.min.js",
      "use": "@vercel/static"
    },
    {
      "src": "Fridayy-Ft.-Asake-Blessings-Remix.mp3",
      "use": "@vercel/static"
    },
    {
      "src": "barakat pictures/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
